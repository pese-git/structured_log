# Generated by scripts/migrate_docs.py from ../docs/ — not committed, same
# convention as every other generated-code output in this repo (*.g.dart,
# *.freezed.dart, pubspec_overrides.yaml: see AGENTS.md). `npm run dev` /
# `npm run build` regenerate it automatically (predev/prebuild). The two
# hand-authored landing pages are the only files under src/content/docs/
# that are actually tracked.
/src/content/docs/**
!/src/content/docs/index.mdx
!/src/content/docs/ru/
!/src/content/docs/ru/index.mdx
