# macOS-specific files
.DS_Store

# Generated by scripts/migrate_docs.py from ../docs/ and emb/*/README(.ru).md
# — not committed, same convention as every other generated-code output in
# this repo (*.g.dart, *.freezed.dart, pubspec_overrides.yaml: see
# AGENTS.md). `npm run dev` / `npm run build` regenerate it automatically
# (predev/prebuild). The landing pages and the packages index are the only
# files under src/content/docs/ that are actually tracked — see PROTECTED
# in scripts/migrate_docs.py, which this list must be kept in sync with.
/src/content/docs/**
!/src/content/docs/index.mdx
!/src/content/docs/packages/
/src/content/docs/packages/*
!/src/content/docs/packages/index.md
!/src/content/docs/ru/
/src/content/docs/ru/*
!/src/content/docs/ru/index.mdx
!/src/content/docs/ru/packages/
/src/content/docs/ru/packages/*
!/src/content/docs/ru/packages/index.md
/public/images/user-guide/
