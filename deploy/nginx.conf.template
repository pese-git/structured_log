# A .template, processed by the base image's own entrypoint (envsubst,
# /etc/nginx/templates/*.template -> /etc/nginx/conf.d/*), not a plain
# nginx.conf — see the Dockerfile for why.
#
# ${NGINX_LOCAL_RESOLVERS} comes from the same image's
# 15-local-resolvers.envsh (enabled by NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
# in the Dockerfile), which reads nameserver lines out of the container's
# own /etc/resolv.conf — Docker's embedded DNS under Compose, the cluster's
# DNS Service under Kubernetes. Nothing here hardcodes which.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # The client is a single-page app: every route it owns has to come back as
  # index.html, or a reload on any screen but the first is a 404.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Same origin for the API. This is what makes the deployment work without
  # CORS: the server sends no `Access-Control-Allow-Origin`, so a client
  # served from a different host could not call it from a browser at all.
  location /v1/ {
    # `proxy_pass` to a *variable* (not the bare literal) is deliberate:
    # nginx resolves a literal upstream once, at startup, and refuses to
    # start at all if "server" doesn't exist yet — fatal for any topology
    # where this container can come up before (or without ever needing)
    # its API sibling, e.g. a deployment that routes /v1/ straight to the
    # API at the ingress/proxy level instead of through this container.
    # Routed through a variable, resolution happens per request instead,
    # using the `resolver` above — a normal 502 instead of a crash loop if
    # "server" is briefly unreachable, and no crash at all if it's never
    # reached through this path in the first place.
    set $upstream_server http://server:8080;
    proxy_pass $upstream_server;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # The server reads the client address for rate limiting and counts
    # `trusted-proxy-hops` entries back from the right of this header. With
    # this proxy in front, that setting is 1 — see deploy/.env.example.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # GET /v1/logs/stream is Server-Sent Events: a long-lived response that
    # must not be buffered or timed out like an ordinary request.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    chunked_transfer_encoding off;
  }

  location = /healthz {
    set $upstream_healthz http://server:8080;
    proxy_pass $upstream_healthz/healthz;
    access_log off;
  }
}
