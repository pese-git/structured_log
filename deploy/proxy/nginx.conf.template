# A .template, processed by the base image's own entrypoint (envsubst,
# /etc/nginx/templates/*.template -> /etc/nginx/conf.d/*). This is the one
# place in the Compose stack that's supposed to know both `web` and
# `server` exist — see ../docker-compose.yml for why neither of them has
# to.
#
# ${NGINX_LOCAL_RESOLVERS} comes from the same image's
# 15-local-resolvers.envsh (enabled by NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
# in docker-compose.yml), which reads nameserver lines out of this
# container's own /etc/resolv.conf — Docker's embedded DNS here.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

server {
  listen 80;
  server_name _;

  # `proxy_pass` to a *variable*, not a bare literal, throughout: a literal
  # resolves once at nginx startup and refuses to start at all if the name
  # isn't up yet. Routed through a variable plus the `resolver` above,
  # resolution happens per request instead — a plain 502 if `web` or
  # `server` is briefly unreachable, never a crash loop over container
  # start order.

  # Same origin for everything. This is what makes the deployment work
  # without CORS: the server sends no `Access-Control-Allow-Origin`, so a
  # client served from a different host could not call the API from a
  # browser at all.
  #
  # Nothing is added to the responses passing through here: the `web` image
  # sets the document's security headers itself (see its `nginx.conf`), and
  # they are proxied through untouched. Setting them again here would send
  # each one twice — two `Content-Security-Policy` headers are enforced as
  # the intersection of both, which is a rule nobody wrote down and one that
  # drifts the moment the two files disagree.
  location / {
    set $upstream_web http://web:80;
    proxy_pass $upstream_web;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /v1/ {
    set $upstream_server http://server:8080;
    proxy_pass $upstream_server;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # The server reads the client address for rate limiting and counts
    # `trusted-proxy-hops` entries back from the right of this header. With
    # this proxy in front, that setting is 1 — see ../.env.example.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The API's own responses never pass through the `web` image, so its
    # headers do not reach them. Only one is added here, and the reason the
    # list is that short is worth writing down: `package:shelf` already sends
    # `x-content-type-options: nosniff`, `x-frame-options` and
    # `x-xss-protection` on every response it produces (checked against a
    # running server, not assumed). `add_header` appends rather than replaces,
    # so repeating `nosniff` here would put it on the wire twice.
    #
    # `Referrer-Policy` is the one shelf does not send, and it matters: these
    # URLs carry group, project and user ids.
    #
    # `Content-Security-Policy` and `X-Frame-Options` are deliberately absent
    # — a JSON body has no document to frame and no subresources to police.
    #
    # `add_header` does not accumulate across levels, so adding a second
    # header to this location later means repeating this one too.
    add_header Referrer-Policy "no-referrer" always;

    # GET /v1/logs/stream is Server-Sent Events: a long-lived response that
    # must not be buffered or timed out like an ordinary request.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    chunked_transfer_encoding off;
  }

  location = /healthz {
    set $upstream_healthz http://server:8080;
    proxy_pass $upstream_healthz/healthz;
    access_log off;
  }
}
