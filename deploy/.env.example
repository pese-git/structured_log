# Copy to .env and edit. Compose reads it automatically.
#
# The JWT signing secret is NOT here: it is mounted from
# deploy/secrets/jwt_secret, so it never reaches an environment
# listing or a compose file that might be committed. deploy.sh generates it
# on first run.

# Where the admin client answers on the host.
STRUCTURED_LOG_PUBLIC_PORT=8080

# debug | info | warning | error
STRUCTURED_LOG_LOG_LEVEL=info

# On an empty database the server creates the first administrator at startup
# and prints a generated password once, as a warning, which must be changed at
# first sign-in. Set the username here; set the password by mounting
# STRUCTURED_LOG_BOOTSTRAP_ADMIN_PASSWORD_FILE if a generated one will not do.
STRUCTURED_LOG_BOOTSTRAP_ADMIN_ENABLED=true
STRUCTURED_LOG_BOOTSTRAP_ADMIN_USERNAME=admin
